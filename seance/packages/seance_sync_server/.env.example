# Per-deployment overrides for docker-compose.yml. Copy to `.env` in this
# directory (gitignored, so `./update.sh` never fights it):
#
#   cp packages/seance_sync_server/.env.example packages/seance_sync_server/.env
#
# Host address the container port is published on. Default (unset) is
# 127.0.0.1 — loopback only, for a reverse proxy running directly on the host.
# A reverse proxy running in a CONTAINER (Nginx Proxy Manager, Traefik, …)
# cannot reach the host's loopback; publish on the Docker bridge gateway
# instead so only the host and its containers can connect:
#
#   SEANCE_PUBLISH_ADDR=172.17.0.1
#
# 0.0.0.0 publishes on every interface — only behind a firewall, or on a
# trusted private network.
#SEANCE_PUBLISH_ADDR=172.17.0.1

# Optional bearer-session policy. Defaults are 30 days and the newest 20
# sessions per account. Both values must be positive integers.
#SEANCE_SESSION_TTL_SECONDS=2592000
#SEANCE_MAX_SESSIONS_PER_ACCOUNT=20

# Optional sync page and durable account limits. A page is capped by both its
# row count and encoded response bytes. The account count/byte ceilings apply
# independently to sync records and pending inbox items. The record count
# covers live records only; deleted records stay as tombstones and count toward
# the byte ceiling alone. Values must be positive integers.
#SEANCE_MAX_RECORDS_PER_PULL=1000
#SEANCE_MAX_PULL_BODY_BYTES=8388608
#SEANCE_MAX_RECORDS_PER_ACCOUNT=5000
#SEANCE_MAX_ACCOUNT_BYTES=41943040

# Authentication limits are global, per immediate source address, and per
# account after failed login verification. Forwarded addresses are ignored
# unless the immediate peer is one of these exact comma-separated IPs.
#SEANCE_LOGIN_MAX_ATTEMPTS=10
#SEANCE_LOGIN_WINDOW_SECONDS=60
#SEANCE_AUTH_GLOBAL_MAX_ATTEMPTS=1000
#SEANCE_AUTH_GLOBAL_WINDOW_SECONDS=60
#SEANCE_AUTH_SOURCE_MAX_ATTEMPTS=60
#SEANCE_AUTH_SOURCE_WINDOW_SECONDS=60
#SEANCE_RATE_LIMIT_MAX_BUCKETS=4096
#SEANCE_TRUSTED_PROXIES=172.17.0.2,172.17.0.3

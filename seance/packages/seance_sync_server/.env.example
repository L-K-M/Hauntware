# Per-deployment overrides for docker-compose.yml. Copy to `.env` in this
# directory (gitignored, so `./update.sh` never fights it):
#
#   cp packages/seance_sync_server/.env.example packages/seance_sync_server/.env
#
# Host address the container port is published on. Default (unset) is
# 127.0.0.1 — loopback only, for a reverse proxy running directly on the host.
# A reverse proxy running in a CONTAINER (Nginx Proxy Manager, Traefik, …)
# cannot reach the host's loopback; publish on the Docker bridge gateway
# instead so only the host and its containers can connect:
#
#   SEANCE_PUBLISH_ADDR=172.17.0.1
#
# 0.0.0.0 publishes on every interface — only behind a firewall, or on a
# trusted private network.
#SEANCE_PUBLISH_ADDR=172.17.0.1

# Optional sync resource limits. The defaults shown here are also used when a
# value is absent. All values are bytes or record counts and must be positive.
#SEANCE_MAX_BODY_BYTES=8388608
#SEANCE_MAX_RECORDS_PER_PUSH=1000
#SEANCE_MAX_BLOB_BYTES=1048576
#SEANCE_MAX_RECORDS_PER_PULL=1000
#SEANCE_MAX_PULL_BODY_BYTES=8388608
#SEANCE_MAX_ACCOUNT_RECORDS=100000
#SEANCE_MAX_ACCOUNT_BYTES=1073741824

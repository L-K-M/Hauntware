    "description": "Desktop-only menu entry and button that imports the hosts of the user's OpenSSH client config file into the fleet (FL-02). The path stays literal."
  },
  "sshConfigImported": "{count, plural, =0{Your ~/.ssh/config names no hosts to import.} =1{Imported 1 server from ~/.ssh/config.} other{Imported {count} servers from ~/.ssh/config.}}",
  "@sshConfigImported": {
    "description": "Shown after an ssh_config import finished; count is the number of servers it added.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },

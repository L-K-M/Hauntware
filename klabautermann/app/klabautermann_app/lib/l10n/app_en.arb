{
  "@@locale": "en",
  "appTitle": "Klabautermann (preview)",
  "@appTitle": {
    "description": "The app's title, with the preview label until v1 (04 §12.3): the task switcher, the About dialog and the about row on the General settings tab. Klabautermann is the display name, an identity: never translated."
  },
  "fleetTitle": "Fleet",
  "fleetSectionServers": "Servers",
  "fleetSectionPinned": "Pinned",
  "@fleetSectionPinned": {
    "description": "Fleet list section header over the synced servers pinned to the top on this device (03 §10.3); drawn in caps."
  },
  "fleetSectionImported": "Imported",
  "@fleetSectionImported": {
    "description": "Fleet list section header over the servers imported from this device's SSH config (FL-02), listed apart from the synced servers and their groups; drawn in caps."
  },
  "fleetRowPin": "Pin to top",
  "@fleetRowPin": {
    "description": "A synced fleet row's menu verb that lists the server under the Pinned section on this device."
  },
  "fleetRowUnpin": "Unpin",
  "@fleetRowUnpin": {
    "description": "A pinned fleet row's menu verb that returns the server to its section."
  },
  "fleetPinNotSaved": "Klabautermann could not save your pinned servers, so the change lasts only until it quits.",
  "@fleetPinNotSaved": {
    "description": "Top toast when pinning or unpinning a server could not be written to the device's settings file; the change holds for this session."
  },
  "fleetRowMonitor": "Monitor",
  "@fleetRowMonitor": {
    "description": "A fleet row's menu verb that adds the server to this device's monitor set (FL-21): Klabautermann then reads it continuously while open and its row shows CPU, memory and disk. Disabled for a server that cannot be monitored."
  },
  "fleetRowStopMonitoring": "Stop monitoring",
  "@fleetRowStopMonitoring": {
    "description": "A monitored fleet row's menu verb that takes the server out of this device's monitor set (FL-21); it is then read only while a view has it open."
  },
  "monitorSetFull": "You can monitor up to {limit} servers on this device. Stop monitoring one first.",
  "@monitorSetFull": {
    "description": "Top toast when the user asks to monitor a server while the monitor set (FL-21) is full; limit is the most servers it holds.",
    "placeholders": {
      "limit": {
        "type": "int"
      }
    }
  },
  "monitorSetNotSaved": "Klabautermann could not save your monitored servers, so the change lasts only until it quits.",
  "@monitorSetNotSaved": {
    "description": "Top toast when a monitor set change applied but could not be written to the device's settings file; the change holds for this session."
  },
  "monitorSetNotChanged": "The monitored servers could not be changed.",
  "@monitorSetNotChanged": {
    "description": "Top toast when the app did not take a monitor set change, such as one from the settings window that the app refused."
  },
  "monitorIneligibleEndpoint": "Confirm this server's endpoint to monitor it.",
  "@monitorIneligibleEndpoint": {
    "description": "Why a synced server cannot join the monitor set (FL-21): this device has not confirmed its endpoint, or a sync changed it since (SAF-09)."
  },
  "monitorIneligibleCredentials": "Signs in with a password or a stored key, which asks you first, so it is read only while you have it open.",
  "@monitorIneligibleCredentials": {
    "description": "Why a server cannot join the monitor set (FL-21): its sign-in needs the user's answer, and continuous reading never asks."
  },
  "monitorIneligibleUnknown": "Import your ssh_config again to monitor this server.",
  "@monitorIneligibleUnknown": {
    "description": "Why an imported server cannot join the monitor set (FL-21): it came from an older import, whose sign-in Klabautermann does not know until the next import."
  },
  "fleetEmptyTitle": "No servers yet",
  "fleetEmptyBody": "Add a server to start monitoring your fleet.",

+    );
+    await _settle();
+
+    expect(other.listCalls, ['/srv/other/home'],
+        reason: 'a pending path from srv-1 must not leak into srv-2');
+    expect(
+      controller.location,
+      const RemotePaneLocation('srv-2', '/srv/other/home'),
+    );
     controller.dispose();
   });
 
